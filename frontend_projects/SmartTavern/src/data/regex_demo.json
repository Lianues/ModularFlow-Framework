{
  "fileName": "RegexDemo.json",
  "rules": [
    {
      "id": "remove_xml",
      "name": "移除 XML 标签",
      "enabled": true,
      "find_regex": "<[^>]+>",
      "replace_regex": "",
      "targets": ["preset", "world_book", "history.user", "history.assistant"],
      "placement": "after_macro",
      "views": ["user_view", "assistant_view"],
      "description": "清洗掉文本内的 XML/HTML 标签"
    },
    {
      "id": "trim_trailing_ws",
      "name": "移除尾随空白",
      "enabled": true,
      "find_regex": "\\s+$",
      "replace_regex": "",
      "targets": ["preset", "char", "persona"],
      "placement": "after_macro",
      "views": [],
      "min_depth": 0,
      "max_depth": 5,
      "description": "删除每行末尾多余空白"
    },
    {
      "id": "normalize_indent",
      "name": "规范缩进",
      "enabled": false,
      "find_regex": "\\t",
      "replace_regex": "    ",
      "targets": [],
      "placement": "before_macro",
      "views": [],
      "description": "将制表符替换为 4 个空格"
    }
  ]
}